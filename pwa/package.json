{
  "name": "pingolin-pwa",
  "version": "3.0.13",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node generate-version.js",
    "dev": "concurrently -n \"SERVER,ELM\" -c \"cyan,magenta\" \"node server.js\" \"npm run watch:elm\"",
    "watch:elm": "chokidar 'src/**/*.elm' -c 'elm make src/Main.elm --output=public/main.js' --initial",
    "prebuild": "node generate-version.js",
    "build": "elm make src/Main.elm --output=public/main.js --optimize && mkdir -p dist && cp -rv public/* dist/ && touch dist/.nojekyll",
    "test:e2e": "playwright test tests/fortress.spec.ts",
    "test:unit": "vitest run tests/sync-worker.spec.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.3",
    "elm": "^0.19.1-6",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.46.0-build1"
  }
}
